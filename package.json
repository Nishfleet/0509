{
  "name": "0509",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "audit:contrast": "node e2e/contrast-audit.mjs",
    "audit:surface": "node e2e/surface-audit.mjs",
    "backup:d1": "mkdir -p backups/d1 && wrangler d1 export \"${D1_DATABASE_NAME:-0509}\" --remote --output \"backups/d1/${D1_DATABASE_NAME:-0509}-$(date -u +%Y-%m-%dT%H-%M-%SZ).sql\"",
    "d1:cleanup-0060:evidence": "node scripts/d1-cleanup-0060-evidence.mjs",
    "build": "node scripts/build-production.mjs",
    "cf-typegen": "WRANGLER_WRITE_LOGS=false wrangler types",
    "canary:proof": "node scripts/launch-readiness-canary.mjs",
    "canary:timeline-coverage": "node scripts/canary-timeline-coverage.mjs",
    "canary:billing": "node scripts/dodo-billing-canary.mjs",
    "canary:pricing": "node scripts/dodo-pricing-canary.mjs",
    "canary:fanout": "node scripts/monitoring-fanout-canary.mjs",
    "canary:presence": "vitest run tests/presence-ga-rollout.test.ts tests/presence-robots.test.ts tests/presence-safe-fetch.test.ts tests/presence-tracking.test.ts",
    "canary:presence-pilot": "vitest run tests/presence-robots.test.ts tests/presence-safe-fetch.test.ts tests/presence-tracking.test.ts tests/presence-pilot-rollout.test.ts",
    "canary:cta-detector": "node scripts/canary-cta-detector.mjs",
    "canary:sitemap-coverage": "node scripts/canary-sitemap-coverage.mjs",
    "canary:fullsite-runs": "node scripts/check-d1-fullsite-runs.mjs",
    "test:presence-load": "node scripts/presence-load-test.mjs",
    "canary:prod": "node scripts/prod-canary.mjs",
    "canary:bet2": "node scripts/bet2-live-verification.mjs --json",
    "canary:bet3": "node scripts/bet3-live-verification.mjs --from-sitemap --json",
    "canary:bet7": "node scripts/bet7-activation-verification.mjs --json",
    "canary:bet9": "node scripts/bet9-first-viewport-verification.mjs --json",
    "canary:search-stream": "node scripts/search-stream-canary.mjs",
    "metrics:traffic": "node scripts/cf-traffic-report.mjs",
    "signal:market": "node scripts/market-signal-snapshot.mjs",
    "signal:market:workdir-check": "bash scripts/check-market-signal-workdir.sh",
    "signal:market:validate": "node scripts/validate-market-signal-report.mjs",
    "metrics:weekly": "node scripts/weekly-business-metrics.mjs",
    "seed:publisher": "node scripts/ads-domain-publisher.mjs",
    "deploy": "wrangler deploy",
    "dev": "react-router dev",
    "e2e": "npm run e2e:local && npm run e2e:prod:public",
    "e2e:auth:capture": "node scripts/e2e-auth-capture.mjs",
    "e2e:install": "playwright install chromium",
    "e2e:local": "E2E_START_LOCAL_SERVER=1 playwright test --config=playwright.config.ts --project=local-auth --project=join-flow",
    "e2e:local:release": "node scripts/run-local-release-proof.mjs --journeys=1,2,3,4,5,6",
    "e2e:prepare:local": "node scripts/e2e-prepare-local.mjs",
    "e2e:preview": "playwright test --config=playwright.config.ts --project=preview-public",
    "e2e:prod:auth": "node scripts/e2e-validate-auth-state.mjs && playwright test --config=playwright.config.ts --project=prod-auth",
    "e2e:prod:public": "playwright test --config=playwright.config.ts --project=prod-public",
    "e2e:serve:local": "npm run e2e:prepare:local && E2E_TEST_MODE=1 E2E_PROVIDER_NETWORK_DENY=1 E2E_SEARCH_ROLLOUT_MODE=v2 AUTH_PROVIDER=better-auth BETTER_AUTH_SECRET=local-test-secret-local-test-secret-local BETTER_AUTH_URL=http://127.0.0.1:4179 APP_ORIGIN=http://127.0.0.1:4179 react-router dev --host 127.0.0.1 --port 4179",
    "launch:readiness": "npm run typecheck && npm test && npm run build && npm audit --omit=dev --audit-level=moderate && npm run e2e:local:release && npm run canary:pricing && npm run canary:billing && npm run canary:proof && npm run canary:prod && npm run provider:bakeoff:launch",
    "preview": "npm run build && vite preview",
    "provider:bakeoff": "node scripts/provider-bakeoff.mjs",
    "provider:bakeoff:launch": "node scripts/provider-bakeoff.mjs --launch-gate",
    "test": "bash ./scripts/ci-vitest-run.sh -- vitest run --configLoader runner --project node && bash ./scripts/ci-vitest-run.sh -- vitest run --configLoader runner --project workers",
    "test:coverage": "bash ./scripts/ci-vitest-run.sh -- vitest run --configLoader runner --project node --coverage",
    "verify:claims": "node scripts/verify-claims.mjs",
    "test:integration": "bash ./scripts/ci-vitest-run.sh -- vitest run --configLoader runner --project workers",
    "migrations:check": "bash ./scripts/ci-vitest-run.sh -- vitest run --configLoader runner --project workers tests/integration/migrations/",
    "test:capture-gate": "vitest run --configLoader runner --project node tests/capture-validity.test.ts tests/capture-validity-pipeline.test.ts tests/capture-validity-termination.test.ts tests/capture-validity-corroboration.test.ts tests/capture-validity-public-rules.test.ts tests/capture-rules-page.test.ts && vitest run --configLoader runner --project workers tests/integration/capture-validity/capture-validity.integration.test.ts",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.0",
    "@noble/hashes": "2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.6.20",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "1.3.0",
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.11.6",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@puppeteer/browsers": "3.2.1",
    "esbuild": "0.28.1",
    "kysely": "0.28.17",
    "sharp": "0.35.4",
    "browserslist": "^4.28.9",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}

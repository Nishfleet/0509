{
  "name": "0509",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "backup:d1": "node scripts/d1-backup.mjs",
    "backup:d1:r2": "node scripts/d1-backup-to-r2.mjs",
    "restore:d1:transform": "node scripts/d1-restore-transform.mjs",
    "restore:d1:remote-evidence": "node scripts/d1-remote-restore-evidence.mjs",
    "d1:cleanup-0060:evidence": "node scripts/d1-cleanup-0060-evidence.mjs",
    "build": "node scripts/build-production.mjs",
    "cf-typegen": "WRANGLER_WRITE_LOGS=false wrangler types",
    "canary:proof": "node scripts/launch-readiness-canary.mjs",
    "canary:billing": "node scripts/dodo-billing-canary.mjs",
    "canary:pricing": "node scripts/dodo-pricing-canary.mjs",
    "canary:fanout": "node scripts/monitoring-fanout-canary.mjs",
    "canary:presence": "node scripts/presence-website-canary.mjs",
    "canary:presence-pilot": "node scripts/presence-pilot-canary.mjs",
    "test:presence-load": "node scripts/presence-load-test.mjs",
    "canary:prod": "node scripts/prod-canary.mjs",
    "gate-c:soak:start": "node scripts/gate-c-soak.mjs start",
    "gate-c:soak:finalize": "node scripts/gate-c-soak.mjs finalize",
    "gate-c:soak:restore": "node scripts/release-evidence-archive.mjs restore",
    "check:public-home": "node scripts/check-public-home-current.mjs",
    "check:google-oauth-branding": "node scripts/check-google-oauth-branding.mjs",
    "check:d1:workspace-memberships": "node scripts/check-workspace-member-invariants.mjs",
    "check:d1:partial-refunds": "node scripts/check-partial-refund-invariants.mjs",
    "signal:market": "node scripts/market-signal-snapshot.mjs",
    "signal:market:validate": "node scripts/validate-market-signal-report.mjs",
    "deploy": "node scripts/deploy-production.mjs",
    "dev": "react-router dev",
    "e2e": "npm run e2e:local && npm run e2e:prod:public",
    "e2e:auth:capture": "node scripts/e2e-auth-capture.mjs",
    "e2e:install": "playwright install chromium",
    "e2e:local": "E2E_START_LOCAL_SERVER=1 playwright test --config=playwright.config.ts --project=local-auth",
    "e2e:local:release": "node scripts/run-local-release-proof.mjs --journeys=1,2,3,4,5,6",
    "e2e:prepare:local": "node scripts/e2e-prepare-local.mjs",
    "e2e:preview": "playwright test --config=playwright.config.ts --project=preview-public",
    "e2e:prod:auth": "node scripts/e2e-validate-auth-state.mjs && playwright test --config=playwright.config.ts --project=prod-auth",
    "e2e:prod:public": "playwright test --config=playwright.config.ts --project=prod-public",
    "e2e:serve:local": "npm run e2e:prepare:local && E2E_TEST_MODE=1 E2E_PROVIDER_NETWORK_DENY=1 E2E_SEARCH_ROLLOUT_MODE=v2 AUTH_PROVIDER=better-auth BETTER_AUTH_SECRET=local-test-secret-local-test-secret-local BETTER_AUTH_URL=http://127.0.0.1:4179 APP_ORIGIN=http://127.0.0.1:4179 react-router dev --host 127.0.0.1 --port 4179",
    "launch:readiness": "npm run typecheck && npm test && npm run build && npm audit --omit=dev --audit-level=moderate && npm run e2e:local:release && npm run canary:pricing && npm run canary:billing && npm run canary:proof && npm run canary:prod && npm run provider:bakeoff:launch",
    "launch:readiness:predeploy": "npm run typecheck && npm test && npm run build && npm audit --omit=dev --audit-level=moderate && npm run e2e:local:release",
    "preview": "npm run build && vite preview",
    "provider:bakeoff": "node scripts/provider-bakeoff.mjs",
    "provider:bakeoff:launch": "node scripts/provider-bakeoff.mjs --launch-gate",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.28",
    "@noble/hashes": "2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.6.20",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "1.3.0",
    "@cloudflare/vite-plugin": "1.51.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.2",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "esbuild": "0.28.1",
    "kysely": "0.28.17",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# no-transform keeps the edge from injecting the Web Analytics module into this
# document. That module is what simulated 4G LCP counts as render delay.
/
  Cache-Control: public, max-age=300, no-transform

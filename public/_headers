/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-gG2BFN3YiWnjq6AQ/Aq8EeGxy1R5WtfNuRPF6Gpc170='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Referrer-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts/* must stay CORS-open: the share picture (app/components/share-image.tsx) is
# screenshotted by Browser Rendering cross-origin, and without this header it silently
# falls back to system fonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/
  Cache-Control: public, max-age=300, no-transform

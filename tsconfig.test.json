{
  "extends": "./tsconfig.json",
  "include": ["tests/**/*.ts", "tests/**/*.json", "e2e/**/*.ts", "*.config.ts", "worker-configuration.d.ts"],
  "exclude": [
    "vite.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "vite/client", "@cloudflare/vitest-plugin/types"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild/test"
  },
  "references": [
    {
      "path": "./tsconfig.cloudflare.json"
    }
  ]
}

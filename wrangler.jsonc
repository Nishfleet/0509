{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0509",
  "compatibility_date": "2026-03-29",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "0509-monitoring",
      "binding": "MONITORING_WORKFLOW",
      "class_name": "MonitoringWorkflow"
    }
  ],
  "routes": [
    {
      "pattern": "0509.io",
      "custom_domain": true
    },
    {
      "pattern": "www.0509.io",
      "custom_domain": true
    },
    {
      "pattern": "api.0509.io",
      "custom_domain": true
    },
    {
      "pattern": "0509.in",
      "custom_domain": true
    },
    {
      "pattern": "www.0509.in",
      "custom_domain": true
    },
    {
      "pattern": "api.0509.in",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *", "0 4 * * *", "0 5 * * MON"]
  },
  "vars": {
    "APP_NAME": "0509",
    "BETTER_AUTH_URL": "https://0509.io",
    "DODO_0509_ADAPTIVE_CURRENCY": "true",
    "DODO_0509_ADAPTIVE_CURRENCY_FEES_INCLUSIVE": "true",
    "DODO_0509_ENVIRONMENT": "live",
    "BROWSER_RUN_ACCOUNT_ID": "f670a698e17bf160c8e4679823e68916",
    "LAUNCH_CANARY_EMAIL": "me@inish.in",
    "EMAIL_FROM_EMAIL": "alerts@0509.in"
  },
  // Secrets configured outside this file via `wrangler secret put`:
  // - CANARY_BYPASS_TOKEN
  // - WHATSAPP_ACCESS_TOKEN
  // - WHATSAPP_APP_SECRET
  // - BROWSER_RUN_API_TOKEN
  // - WHATSAPP_PHONE_NUMBER_ID
  // - WHATSAPP_TEMPLATE_NAMESPACE
  // - WHATSAPP_WEBHOOK_VERIFY_TOKEN
  // - DODO_PAYMENTS_API_KEY
  // - DODO_0509_API_KEY (optional override if 0509 ever needs its own key)
  // - DODO_0509_BRAND_ID
  // - DODO_0509_WEBHOOK_SECRET
  // - DODO_0509_PRODUCT_SCOUT_MONTHLY_ID
  // - DODO_0509_PRODUCT_SCOUT_YEARLY_ID
  // - DODO_0509_PRODUCT_STARTER_MONTHLY_ID
  // - DODO_0509_PRODUCT_STARTER_YEARLY_ID
  // - DODO_0509_PRODUCT_AGENCY_MONTHLY_ID
  // - DODO_0509_PRODUCT_AGENCY_YEARLY_ID
  // - DODO_0509_PRODUCT_PROOF_PACK_500_ID
  // - DODO_0509_PRODUCT_PROOF_PACK_2000_ID
  // - DODO_0509_PRODUCT_PROOF_PACK_7500_ID
  // - META_TOKEN_ENCRYPTION_SECRET
  // Email sending uses the Cloudflare Email Service `send_email` binding above —
  // no API key secret. Email currently sends from the verified 0509.in sending
  // domain until 0509.io is separately onboarded to Email Service.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0509",
      "database_id": "746c6e3d-782e-443a-82d6-28ca93a16294"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LANDING_PAGE_ARTIFACTS",
      "bucket_name": "0509-landing-page-artifacts"
    }
  ]
}

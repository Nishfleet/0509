{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0509",
  "compatibility_date": "2026-03-29",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "0509-monitoring",
      "binding": "MONITORING_WORKFLOW",
      "class_name": "MonitoringWorkflow"
    }
  ],
  "routes": [
    {
      "pattern": "0509.in",
      "custom_domain": true
    },
    {
      "pattern": "www.0509.in",
      "custom_domain": true
    },
    {
      "pattern": "api.0509.in",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["17 */6 * * *", "0 4 * * *", "0 5 * * MON"]
  },
  "vars": {
    "APP_NAME": "0509",
    "APP_REGION_DEFAULT": "rest_of_world",
    "BROWSER_RUN_ACCOUNT_ID": "f670a698e17bf160c8e4679823e68916",
    "LAUNCH_CANARY_EMAIL": "me@inish.in"
  },
  // Secrets configured outside this file via `wrangler secret put`:
  // - CANARY_BYPASS_TOKEN
  // - WHATSAPP_ACCESS_TOKEN
  // - WHATSAPP_APP_SECRET
  // - BROWSER_RUN_API_TOKEN
  // - WHATSAPP_PHONE_NUMBER_ID
  // - WHATSAPP_TEMPLATE_NAMESPACE
  // - WHATSAPP_WEBHOOK_VERIFY_TOKEN
  // - RAZORPAY_KEY_ID
  // - RAZORPAY_KEY_SECRET
  // - RAZORPAY_WEBHOOK_SECRET
  // - RAZORPAY_PLAN_STARTER_MONTHLY
  // - RAZORPAY_PLAN_STARTER_YEARLY
  // - RAZORPAY_PLAN_AGENCY_MONTHLY
  // - RAZORPAY_PLAN_AGENCY_YEARLY
  // - DODO_0509_BRAND_ID
  // - DODO_0509_ENVIRONMENT (test or live)
  // - DODO_0509_PAYMENTS_API_KEY
  // - DODO_0509_PAYMENTS_WEBHOOK_KEY
  // - DODO_0509_PRODUCT_STARTER_MONTHLY
  // - DODO_0509_PRODUCT_STARTER_YEARLY
  // - DODO_0509_PRODUCT_AGENCY_MONTHLY
  // - DODO_0509_PRODUCT_AGENCY_YEARLY
  // - META_TOKEN_ENCRYPTION_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0509",
      "database_id": "746c6e3d-782e-443a-82d6-28ca93a16294"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LANDING_PAGE_ARTIFACTS",
      "bucket_name": "0509-landing-page-artifacts"
    }
  ]
}

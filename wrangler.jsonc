/**
 * Worker config for Five to Nine (0509).
 *
 * The Worker name stays "0509" on purpose: Worker secrets are scoped to the
 * name, so renaming it would orphan DODO_API_KEY, BETTER_AUTH_* and the rest,
 * and the first deploy would come up unconfigured.
 *
 * Declares only what this app uses. The pre-rebuild Worker carried Workflow and
 * Durable Object classes, eight rate-limit bindings and eight cron triggers;
 * none are here, because nothing in this app reads them. Bindings come back one
 * at a time, with the engine packet that needs them.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0509",
  // >= 2026-08-04, so nodejs_compat is on by default and needs no flag.
  "compatibility_date": "2026-09-16",
  "main": "./workers/app.ts",
  "observability": {
    // p95 request duration per route comes from here, which is how
    // docs/REBUILD-DONE.md's performance gate gets measured without a load
    // generator pointed at production.
    "enabled": true
  },
  "upload_source_maps": true,

  // The pre-rebuild Worker declared one Durable Object class,
  // SelectionEnrichmentLease (tag v1, new_sqlite_classes). The fresh app does
  // not export it, and Cloudflare refuses a version that drops a class still
  // backing live Durable Objects:
  //
  //   New version of script does not export class 'SelectionEnrichmentLease'
  //   which is depended on by existing Durable Objects [code: 10064]
  //
  // A delete-class migration is the mechanism the error itself names. This
  // deletes the objects along with the class, which is correct here: the lease
  // was ad-hoc coordination for the old selection pipeline, that pipeline is
  // gone, and there are 0 users. Tag v2 follows the old v1 so the chain is
  // continuous rather than restarting.
  // The chain has to carry its own history: wrangler validates it locally and
  // rejects deleting a class this config never declared ("Cannot apply
  // deleted_classes migration to non-existent class"). v1 mirrors what the
  // pre-rebuild Worker did; v2 removes it. End state: no Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SelectionEnrichmentLease"] },
    { "tag": "v2", "deleted_classes": ["SelectionEnrichmentLease"] }
  ],

  // BETTER_AUTH_URL must be the canonical origin, never derived from a
  // forwarded header: auth origin trust and the magic-link URL both come from
  // it, and a client-supplied value would let a link point anywhere.
  // BETTER_AUTH_SECRET stays a Worker secret.
  //
  // JEV_URL is the TypeSafe evaluation-model endpoint — the same
  // ai-gateway.vercel.sh URL the fleet's LiteLLM /jev pass-through wraps
  // (fleet-ops config/litellm-proxy.yaml). The credential stays a Worker
  // secret: `wrangler secret put JEV_API_KEY`. Local dev overrides the URL to
  // the fleet proxy (127.0.0.1:4000/jev) via .dev.vars, which takes the proxy's
  // virtual key as JEV_API_KEY instead.
  "vars": {
    "BETTER_AUTH_URL": "https://0509.io",
    "BROWSER_CONCURRENCY_CAP": "10",
    "JEV_URL": "https://ai-gateway.vercel.sh/v4/ai/evaluation-model"
  },

  // Identity-card engine (#3885): 24 h probe cache. No id — wrangler
  // provisions the namespace on first deploy and keeps it linked, same as
  // 0509-e2e-inbox's INBOX binding.
  "kv_namespaces": [{ "binding": "IDENTITY_CACHE" }],

  // Snapshot bodies (raw HTML) live in R2; D1 keeps the fact row.
  // The second binding is the public standing card's pre-rendered artifact
  // (issue #3969, engine 9). The weekly rollover (engine 6) writes
  // card/<workspace_id>/<week_start_at>/{index.html,og.png} here and /s/<slug>
  // streams it. A binding on the existing 0509-snapshots bucket under the card/
  // prefix, not a bucket of its own: docs/REBUILD-GUARDRAILS.md §3 (merged
  // #4028) already assigns card/ its 90-day expiry plus the 7-day multipart
  // abort, and docs/engines/standing-card.md says this engine's R2 objects fall
  // under that same rule. A separate bucket would carry no lifecycle rule and
  // would name a bucket nobody has created on the first main deploy to
  // reference R2. The public-read separation argument is dropped and recorded
  // as dropped: the card objects stay public by serving through the route,
  // while the bucket itself is not exposed as a domain.
  "r2_buckets": [
    { "binding": "SNAPSHOTS", "bucket_name": "0509-snapshots" },
    { "binding": "CARD_ARTIFACTS", "bucket_name": "0509-snapshots" }
  ],

  // The durable tail: persist -> seed-watches -> start-discovery ->
  // first-snapshot after the user confirms the card.
  "workflows": [
    { "name": "identity-tail", "binding": "IDENTITY_TAIL", "class_name": "IdentityTailWorkflow" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0509",
      "database_id": "746c6e3d-782e-443a-82d6-28ca93a16294"
    }
  ],

  // Browser Rendering: brand pages bot-gate a plain workerd fetch, so every
  // arbitrary-homepage read goes through real Chrome. Measured ~7 s per ads
  // pull; the cost model turns on keeping concurrency at or under the included
  // ten (docs/REBUILD-COST.md).
  //
  // Since P3 (#3971) it is the escalation target of the fetch-then-browser
  // transport in app/lib/fetch/transport.ts: that module tries a plain `fetch`
  // first and only reaches for this binding when the fetch is refused, so the
  // binding now backs the interactive path as well as the sweep path.
  "browser": { "binding": "BROWSER" },

  // Transactional send only. The weekly brief's standing on this lane is an
  // open question recorded on docs/REBUILD-DELIVERY.md.
  "send_email": [{ "name": "EMAIL" }],

  // The page-sweep producer is the identity tail's start-discovery step
  // (#3885); the queue's consumer ships with the discovery engine (#3884).
  // The one send lane (0509#3979, docs/engines/delivery.md § P7.2, §5) is the
  // consumer below. The weekly brief (engine 6) and the incident email
  // (engine 4) both write their row and put `{ digest_id }` on `send-email`;
  // this consumer is the only thing that calls EMAIL.send. The numbers are the
  // packet's, not defaults: max_batch_size 1 because each send is its own API
  // call and a partial batch failure is ambiguous; max_concurrency 2 because
  // Email Service is Beta with unpublished, reputation-gated daily limits and
  // a cold domain, so two concurrent sends clears a 25-workspace Monday
  // without looking like a blast. The dead letter queue is mandatory —
  // messages that reach the retry limit are deleted permanently otherwise, and
  // a silently dropped brief is the failure the contract forbids.
  "queues": {
    "producers": [{ "queue": "page-sweep", "binding": "PAGE_SWEEP" }],
    "consumers": [
      {
        "queue": "send-email",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "send-email-dlq"
      }
    ]
  },

  "triggers": {
    // The dead-man ping, and nothing else yet. Every five minutes: an external
    // service alerts when the reports stop, which is the one failure a Worker
    // cannot report about itself.
    "crons": ["*/5 * * * *"]
  },

  "routes": [
    { "pattern": "0509.io", "custom_domain": true },
    { "pattern": "www.0509.io", "custom_domain": true },
    { "pattern": "api.0509.io", "custom_domain": true }
    // The .in hosts are deliberately absent. Their 308 to the .io twins is a
    // zone-level Redirect Rule on the 0509.in zone (phase
    // http_request_dynamic_redirect, ruleset f7743879d6904ebea189b42c85713069),
    // which runs before the Worker and costs no invocation. Adding a route here
    // would put the Worker in that path for nothing.
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0509",
  "compatibility_date": "2026-03-29",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "placement": { "mode": "smart" },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "0509-monitoring",
      "binding": "MONITORING_WORKFLOW",
      "class_name": "MonitoringWorkflow"
    }
  ],
  "routes": [
    {
      "pattern": "0509.io",
      "custom_domain": true
    },
    {
      "pattern": "www.0509.io",
      "custom_domain": true
    },
    {
      "pattern": "api.0509.io",
      "custom_domain": true
    },
    {
      "pattern": "0509.in",
      "custom_domain": true
    },
    {
      "pattern": "www.0509.in",
      "custom_domain": true
    },
    {
      "pattern": "api.0509.in",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["13 * * * *", "17 */6 * * *", "0 */3 * * *", "0 4 * * *", "0 5 * * MON"]
  },
  "vars": {
    "APP_NAME": "0509",
    "APP_ORIGIN": "https://0509.io",
    "AUTH_PROVIDER": "better-auth",
    "BETTER_AUTH_URL": "https://0509.io",
    "DODO_0509_ADAPTIVE_CURRENCY": "true",
    "DODO_0509_ADAPTIVE_CURRENCY_FEES_INCLUSIVE": "true",
    "DODO_0509_ENVIRONMENT": "live",
    "BROWSER_RUN_ACCOUNT_ID": "f670a698e17bf160c8e4679823e68916",
    "LAUNCH_CANARY_EMAIL": "me@inish.in",
    "EMAIL_FROM_EMAIL": "alerts@0509.io",
    "E2E_TEST_MODE": "0",
    "MONITORING_FANOUT_MODE": "fanout",
    "MONITORING_FANOUT_GLOBAL": "1",
    "MONITORING_FANOUT_MAX_INFLIGHT": "8",
    "MONITORING_ORCHESTRATION_LEASE_MS": "3600000",
    "MONITORING_ORCHESTRATION_MAX_AGE_MS": "7200000",
    "MONITORING_CONCURRENCY_SLOT_LEASE_MS": "3600000",
    "MONITORING_SCHEDULED_BROWSER_MODE": "billing",
    "BROWSER_RUN_SESSION_REUSE": "0",
    // Issue #1919: allow the existing Browserless proof fallback leg for the
    // five demo /timeline brands (www and apex — mamaearth 301s www → apex)
    // so a second provider can capture a proof-bearing snapshot when the
    // Browser Run session is blocked or the page is too heavy for it. The
    // two 0509.io defaults are restated because a configured list replaces them.
    // Issue #2140: the festive-india-2026 /ads seed cohort's www + apex origins
    // get the same fallback leg so published brand pages can capture proofs.
    "BROWSERLESS_PROOF_ALLOWLIST_ORIGINS": "https://0509.io https://www.0509.io https://www.nike.com https://nike.com https://www.nykaa.com https://nykaa.com https://www.allbirds.com https://allbirds.com https://www.lenskart.com https://lenskart.com https://www.mamaearth.com https://mamaearth.com https://www.sugarcosmetics.com https://sugarcosmetics.com https://www.plumgoodness.com https://plumgoodness.com https://www.mcaffeine.com https://mcaffeine.com https://www.thedermaco.com https://thedermaco.com https://www.dotandkey.com https://dotandkey.com https://www.wowskinscience.com https://wowskinscience.com https://www.forestessentials.com https://forestessentials.com https://www.kamaayurveda.com https://kamaayurveda.com https://www.bewakoof.com https://bewakoof.com https://www.thesouledstore.com https://thesouledstore.com https://www.snitch.co.in https://snitch.co.in https://www.zivame.com https://zivame.com https://www.clovia.com https://clovia.com https://www.damensch.com https://damensch.com https://www.xyxxcrew.com https://xyxxcrew.com https://www.libas.in https://libas.in https://www.boat-lifestyle.com https://boat-lifestyle.com https://www.noisefit.com https://noisefit.com https://www.fireboltt.com https://fireboltt.com https://www.portronics.com https://portronics.com https://www.zebronics.com https://zebronics.com https://www.ambraneindia.com https://ambraneindia.com https://www.dailyobjects.com https://dailyobjects.com https://www.thewholetruthfoods.com https://thewholetruthfoods.com https://www.slurrpfarm.com https://slurrpfarm.com https://www.vahdamteas.com https://vahdamteas.com https://www.teabox.com https://teabox.com https://www.bluetokaicoffee.com https://bluetokaicoffee.com https://www.epigamia.com https://epigamia.com https://www.countrydelight.in https://countrydelight.in",
    "SEARCH_ROLLOUT_MODE": "v2",
    "ADS_DOMAIN_PUBLISHER_CAP": "60",
    "PRESENCE_WEBSITE_ROLLOUT": "generally_available",
    "PRESENCE_DIGEST_ROLLOUT": "disabled",
    "PRESENCE_X_ROLLOUT": "disabled",
    "PRESENCE_REDDIT_ROLLOUT": "disabled",
    "PRESENCE_LINKEDIN_ROLLOUT": "disabled",
    // Spec §8 gates cleared 2026-09-09 (issues #2103/#2104/#2105 + Nish's gates
    // 1-2 approval on issue #2106; retention 90 days). Post-deploy canary:
    // node scripts/funnel-canary-check.mjs. Rollback: flip back to "0".
    "FUNNEL_MEASUREMENT_ENABLED": "1",
    "SIGNUP_FIRST_BRIEF_ENABLED": "1",
    // Issue #1386 (EPIC #1367 Q5): Full-Site Watch on a nike.com canary first.
    // Broad rollout is emptying FULLSITE_WATCH_CANARY_HOSTS. Rollback is
    // flipping this flag off.
    "FULLSITE_WATCH_ENABLED": "true",
    "FULLSITE_WATCH_CANARY_HOSTS": "nike.com www.nike.com"
  },
  // Secrets configured outside this file via `wrangler secret put`:
  // - CANARY_BYPASS_TOKEN
  // - BROWSER_RUN_API_TOKEN
  // - DODO_PAYMENTS_API_KEY
  // - BETTER_AUTH_SECRET
  // - BETTER_AUTH_GOOGLE_CLIENT_ID (optional Google credential; not enough to expose Google)
  // - BETTER_AUTH_GOOGLE_CLIENT_SECRET (optional Google credential; store as secret)
  // - BETTER_AUTH_MICROSOFT_CLIENT_ID (optional Microsoft credential; not enough to expose Microsoft)
  // - BETTER_AUTH_MICROSOFT_CLIENT_SECRET (optional Microsoft credential; store as secret)
  // - BETTER_AUTH_MICROSOFT_ACCOUNT_LINKING_TRUSTED (optional; set true only after accepting same-email Microsoft account linking)
  // - BETTER_AUTH_MICROSOFT_TENANT_ID (optional; defaults to common)
  // - BETTER_AUTH_OAUTH_BRANDED_PROVIDERS (optional comma-separated google,microsoft after account chooser branding is verified)
  // - BETTER_AUTH_TRUSTED_ORIGINS (optional comma-separated preview origins)
  // - UNSUBSCRIBE_SIGNING_SECRET
  // - DODO_0509_API_KEY (optional override if 0509 ever needs its own key)
  // - DODO_0509_BRAND_ID
  // - DODO_0509_WEBHOOK_SECRET
  // - DODO_0509_PRODUCT_SCOUT_MONTHLY_ID
  // - DODO_0509_PRODUCT_SCOUT_YEARLY_ID
  // - DODO_0509_PRODUCT_STARTER_MONTHLY_ID
  // - DODO_0509_PRODUCT_STARTER_YEARLY_ID
  // - DODO_0509_PRODUCT_AGENCY_MONTHLY_ID
  // - DODO_0509_PRODUCT_AGENCY_YEARLY_ID
  // - DODO_0509_PRODUCT_PROOF_PACK_500_ID
  // - DODO_0509_PRODUCT_PROOF_PACK_2000_ID
  // - DODO_0509_PRODUCT_PROOF_PACK_7500_ID
  // - MONITORING_FANOUT_INTERNAL_WORKSPACE_USER_ID (owner-documented pilot workspace; never commit a value)
  // - PRESENCE_OAUTH_STATE_SECRET (32+ bytes; fail closed when missing)
  // - PRESENCE_INTERNAL_WORKSPACE_ID (owner-documented internal presence pilot workspace; never commit a value)
  // - META_TOKEN_ENCRYPTION_SECRET
  // Email sending uses the Cloudflare Email Service `send_email` binding above —
  // no API key secret. The active sender is the 0509.io brand address.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0509",
      "database_id": "746c6e3d-782e-443a-82d6-28ca93a16294"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LANDING_PAGE_ARTIFACTS",
      "bucket_name": "0509-landing-page-artifacts"
    }
  ]
}

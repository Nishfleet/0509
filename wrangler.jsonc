{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0509",
  "compatibility_date": "2026-03-29",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "0509.in",
      "custom_domain": true
    },
    {
      "pattern": "www.0509.in",
      "custom_domain": true
    },
    {
      "pattern": "api.0509.in",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 4 * * *", "0 5 * * MON"]
  },
  "vars": {
    "APP_NAME": "0509",
    "APP_REGION_DEFAULT": "rest_of_world"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0509",
      "database_id": "746c6e3d-782e-443a-82d6-28ca93a16294"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LANDING_PAGE_ARTIFACTS",
      "bucket_name": "0509-landing-page-artifacts"
    }
  ],
  // Add Browser Rendering and any workflows/queues bindings here when provisioned.
}

{
  "manifest_version": 3,
  "name": "Five to Nine — Competitor Ads",
  "version": "1.0.0",
  "description": "See any brand's Meta ads. One click from their website.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "See this brand's Meta ads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

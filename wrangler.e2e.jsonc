{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0509-e2e-local",
  "compatibility_date": "2026-03-29",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": []
  },
  "vars": {
    "APP_NAME": "0509",
    "AUTH_PROVIDER": "better-auth",
    "E2E_PROVIDER_NETWORK_DENY": "1",
    "E2E_TEST_MODE": "1",
    "SEARCH_ROLLOUT_MODE": "v2",
    "MONITORING_FANOUT_MODE": "inline",
    "PRESENCE_WEBSITE_ROLLOUT": "disabled",
    "PRESENCE_DIGEST_ROLLOUT": "disabled",
    "PRESENCE_X_ROLLOUT": "disabled",
    "PRESENCE_REDDIT_ROLLOUT": "disabled",
    "PRESENCE_LINKEDIN_ROLLOUT": "disabled"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0509",
      "database_id": "746c6e3d-782e-443a-82d6-28ca93a16294"
    }
  ],
  "workflows": [
    {
      "name": "0509-monitoring-e2e-local",
      "binding": "MONITORING_WORKFLOW",
      "class_name": "MonitoringWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LANDING_PAGE_ARTIFACTS",
      "bucket_name": "0509-landing-page-artifacts"
    }
  ],
  "unsafe": {
    "bindings": [
      // Mirrors the production RL_* Rate Limiting bindings (issue #2985).
      // E2E mode short-circuits the limiters, but the config must stay a
      // valid mirror of production wiring.
      { "name": "RL_AUTH",
 "type": "ratelimit", "namespace_id": "0509-rl-auth", "simple": { "limit": 2, "period": 60 } },
      { "name": "RL_SEARCH_ANON_BROWSER",
 "type": "ratelimit", "namespace_id": "0509-rl-search-anon-browser", "simple": { "limit": 2, "period": 60 } },
      { "name": "RL_PROOF_BRIEF",
 "type": "ratelimit", "namespace_id": "0509-rl-proof-brief", "simple": { "limit": 3, "period": 60 } },
      { "name": "RL_SEARCH_SELECTION",
 "type": "ratelimit", "namespace_id": "0509-rl-search-selection", "simple": { "limit": 3, "period": 60 } },
      { "name": "RL_SEARCH_IP",
 "type": "ratelimit", "namespace_id": "0509-rl-search-ip", "simple": { "limit": 10, "period": 60 } },
      { "name": "RL_BRAND_PAGE",
 "type": "ratelimit", "namespace_id": "0509-rl-brand-page", "simple": { "limit": 12, "period": 60 } },
      { "name": "RL_WRITE",
 "type": "ratelimit", "namespace_id": "0509-rl-write", "simple": { "limit": 60, "period": 60 } },
      { "name": "RL_STATUS",
 "type": "ratelimit", "namespace_id": "0509-rl-status", "simple": { "limit": 120, "period": 60 } },
      { "name": "RL_DELIVERY_WEBHOOK",
 "type": "ratelimit", "namespace_id": "0509-rl-delivery-webhook", "simple": { "limit": 180, "period": 60 } },
      { "name": "RL_API_READ",
 "type": "ratelimit", "namespace_id": "0509-rl-api-read", "simple": { "limit": 240, "period": 60 } },
      { "name": "RL_WEBHOOK",
 "type": "ratelimit", "namespace_id": "0509-rl-webhook", "simple": { "limit": 300, "period": 60 } }
    ]
  }
}

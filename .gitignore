# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/node_modules
/coverage
/.next/
/build
/backups/
/restore.sql
/restore.sqlite
/.react-router/
/.wrangler/
/.playwright-mcp/
/.auth/
/test-results/
/playwright-report/
/output/
/var/visual-audit/
/tmp/

.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.env*
.dev.vars
.dev.vars.*

.vercel
*.tsbuildinfo
worker-configuration.d.ts

# Track only the shared Codex local-environment surface.
.codex/*
!.codex/environments/
.codex/environments/*
!.codex/environments/environment.toml
.gstack/

# Operational telemetry cache (e.g. ci-failure-telemetry JSON dumps)
/.cache/

# Vale quality-ratchet measurement config (created and removed by scripts/quality-ratchet.mjs)
/.vale-ratchet-measure-*.ini

# Worker PR-body scratch files (fleet-ops/0509#2609)
/pr-body.md
/.pr-body.md
# Same scratch files when a lane writes them beside its plan. They are the PR
# body text, which already lives on GitHub, so committing one only adds a
# second copy for reviewers and for the `Vale` prose gate to disagree with
# (0509#3138: a committed `.fleet/pr-body-2985.md` failed `vale` on the word
# "granularity" after every code check had passed).
.fleet/pr-body-*.md

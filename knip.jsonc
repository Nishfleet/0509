{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead code is the gardener's first job (talk 25:19: "delete tech debt that
  // we already have"). knip is the stock finder; every entry below is the app's
  // real front door, so anything it cannot reach from here is unreachable in
  // production too.
  "entry": [
    "app/routes/**/*.{ts,tsx}",
    "app/root.tsx",
    "app/routes.ts",
    "workers/app.ts",
    // The e2e inbox Worker's front door is its own wrangler config
    // (workers/e2e-inbox.wrangler.jsonc), which knip does not read — the file
    // is an entry by name.
    "workers/e2e-inbox.ts",
    // The support inbox Worker's front door is its own wrangler config
    // (workers/support-inbox.wrangler.jsonc), which knip does not read — the
    // file is an entry by name.
    "workers/support-inbox.ts",
    // The fixture-site Worker's front door is its own wrangler config
    // (workers/fixture-site.wrangler.jsonc), which knip does not read — the
    // file is an entry by name.
    "workers/fixture-site.ts",
    "e2e/*.setup.ts",
    "app/components/ui/*.{ts,tsx}"
  ],
  "project": ["app/**/*.{ts,tsx}", "workers/**/*.ts", "e2e/**/*.ts", "tests/**/*.ts"],

  // `cloudflare:workers` is a Workers runtime module, not an npm package; knip
  // reads the scheme as a package name. `@react-router/node` is knip's
  // react-router plugin resolving @react-router/dev's config entry points.
  // Neither is a missing dependency.
  // `tailwindcss` is imported by `@import "tailwindcss"` in app/app.css; knip
  // does not follow CSS imports and says so in its own hint output.
  "ignoreDependencies": ["cloudflare", "@react-router/node", "tailwindcss"],

  "ignore": ["**/+types/**", "docs/design-directions/**", "lighthouserc.cjs"]
}

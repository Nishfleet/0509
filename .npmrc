# Dependabot rewrites package-lock.json with the npm in its own image (11+),
# which prunes the optional-peer stub entries npm 10 (the npm Node 22 ships)
# writes and then demands back in `npm ci`, so every Dependabot pull request
# failed with "Missing: proxy-agent@8.0.2 from lock file" (0509#7776). Every
# peer this repo needs is a direct dependency, so ignoring peer ranges makes
# both npm majors read and write one lockfile shape.
legacy-peer-deps=true

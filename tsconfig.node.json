{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "tests/**/*",
    "app/lib/**/*",
    "app/routes.ts",
    "app/routes/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "ignoreDeprecations": "5.0",
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}

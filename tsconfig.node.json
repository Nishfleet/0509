{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "vite.config.ts",
    "scripts/prod-canary*.mjs",
    "scripts/monitoring-fanout-canary*.mjs",
    "scripts/provider-bakeoff*.mjs",
    "scripts/dodo-pricing-canary.mjs",
    "scripts/presence-website-canary.mjs",
    "scripts/d1-cleanup-0060-evidence.mjs",
    "scripts/d1-migration-sync-check*.mjs",
    "scripts/d1-backup-command-args.mjs",
    "scripts/safe-command-output.mjs",
    "tests/**/*",
    "app/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "ignoreDeprecations": "5.0",
    "types": ["vite/client", "node"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}

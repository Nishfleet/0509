{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "playwright.config.ts",
    "vite.config.ts",
    "scripts/prod-canary*.mjs",
    "scripts/monitoring-fanout-canary*.mjs",
    "scripts/provider-bakeoff*.mjs",
    "scripts/dodo-pricing-canary.mjs",
    "scripts/presence-website-canary.mjs",
    "scripts/d1-cleanup-0060-evidence.mjs",
    "scripts/d1-migration-sync-check*.mjs",
    "scripts/workspace-member-preflight*.mjs",
    "scripts/partial-refund-preflight*.mjs",
    "scripts/d1-backup-command-args.mjs",
    "scripts/d1-backup-local-storage.mjs",
    "scripts/d1-backup-lifecycle-canary.mjs",
    "scripts/d1-backup-to-r2.mjs",
    "scripts/d1-backup-local-cleanup.mjs",
    "scripts/d1-restore-transform.mjs",
    "scripts/d1-remote-restore-evidence.mjs",
    "scripts/d1-remote-restore-evidence-core.mjs",
    "scripts/find-recent-remote-restore-artifact.mjs",
    "scripts/build-remote-restore-candidate-manifest.mjs",
    "scripts/dodo-billing-canary.mjs",
    "scripts/e2e-auth-capture.mjs",
    "scripts/e2e-auth-state-paths.mjs",
    "scripts/e2e-local-fixture.mjs",
    "scripts/e2e-local-state-query.mjs",
    "scripts/e2e-validate-auth-state.mjs",
    "scripts/launch-readiness-canary.mjs",
    "scripts/launch-readiness-canary-cycle.mjs",
    "scripts/local-release-server.mjs",
    "scripts/playwright-release-manifest-reporter.mjs",
    "scripts/check-deferred-release-zero-migrations.mjs",
    "scripts/deploy-production-plan.mjs",
    "scripts/verify-deploy-readiness.mjs",
    "scripts/verify-remote-restore-evidence.mjs",
    "scripts/verify-cross-browser-risk-proof.mjs",
    "scripts/verify-post-deploy-release.mjs",
    "scripts/worker-rollback-target.mjs",
    "scripts/gate-c-soak*.mjs",
    "scripts/check-live-public-home*.mjs",
    "scripts/release-scheduled-observation-contract.mjs",
    "scripts/release-evidence-archive.mjs",
    "e2e/helpers/release-scope.mjs",
    "e2e/helpers/release-origin.ts",
    "e2e/helpers/release-experience.ts",
    "e2e/helpers/release-artifacts.ts",
    "e2e/helpers/release-test.ts",
    "e2e/journey-*-release.spec.ts",
    "scripts/safe-command-output.mjs",
    "scripts/market-signal-snapshot.mjs",
    "scripts/validate-market-signal-report.mjs",
    "tests/**/*",
    "extension/lib/**/*.mjs",
    "app/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "ignoreDeprecations": "5.0",
    // `@cloudflare/vitest-plugin/types` declares the `cloudflare:test` module
    // used by tests/integration/**; `cloudflare:workers` comes from the
    // generated worker-configuration.d.ts.
    "types": ["vite/client", "node", "@cloudflare/vitest-plugin/types"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}

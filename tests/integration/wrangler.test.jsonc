{
  "name": "0509-test",
  "compatibility_date": "2026-09-16",
  "main": "../../workers/app.ts",
  "d1_databases": [{ "binding": "DB", "database_name": "0509-test", "database_id": "test" }],
  "r2_buckets": [
    { "binding": "CARD_ARTIFACTS", "bucket_name": "0509-snapshots-test" },
    { "binding": "SNAPSHOTS", "bucket_name": "0509-snapshots-test" }
  ],
  "queues": { "producers": [{ "queue": "send-email", "binding": "SEND_EMAIL" }] },
  "workflows": [
    {
      "name": "standing-rollover-test",
      "binding": "STANDING_ROLLOVER",
      "class_name": "StandingRolloverWorkflow"
    }
  ],
  "kv_namespaces": [
    { "binding": "IDENTITY_CACHE", "id": "test" },
    { "binding": "RESOLVE_CACHE", "id": "resolve-cache-test" }
  ]
}

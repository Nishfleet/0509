// Test config for the J8 fixture-site Worker (0509#4046): real workerd, real
// local SQLite Durable Object. FIXTURE_SITE_TOKEN is a var here so the flip route's token gate has
// something to check — production gets it as a secret on the deployed Worker.
{
  "name": "0509-fixture-site-test",
  "compatibility_date": "2026-09-16",
  "main": "../../workers/fixture-site.ts",
  "durable_objects": {
    "bindings": [{ "name": "STATE", "class_name": "FixtureState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FixtureState"] }],
  "vars": { "FIXTURE_SITE_TOKEN": "integration-token" }
}

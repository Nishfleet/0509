[Unit]
Description=Run the 0509 /ads rate-limit error-body regression guard daily
Documentation=https://github.com/Nishfleet/0509/blob/main/docs/ops-backup-uptime.md

[Timer]
# Daily 02:17 UTC = 07:47 IST, offset clear of the 00:07 market-signal
# snapshot, the 20:07/20:47 provider-mutation windows, and the 01:47
# search-h1 guard. The guard is a nightly regression detector (accept
# criterion #4), not an SLO probe, so a daily cadence is the right
# sensitivity. It drives the /ads page until the anonymous brand-page
# limiter trips (120 requests / 10 min per IP), so it briefly consumes the
# VPS IP's own preview budget — a daily run is a small, bounded cost.
OnCalendar=*-*-* 02:17:00
Persistent=true
Unit=0509-public-brand-page-rate-limit-guard.service

[Install]
WantedBy=timers.target

[Unit]
Description=0509 proof screenshot-metric guard (7-day screenshot rate + budget-skip surface, issue #1985)
Documentation=https://github.com/Nishfleet/0509/blob/main/docs/ops-backup-uptime.md
# Independent of any GitHub Actions runner: the guard must keep firing while
# every runner is busy or offline, and its failure must reach journald + a
# watchdog even when GitHub's scheduled-cron lottery would skip it.

[Service]
Type=oneshot
# The guard reads production D1 via wrangler, so it runs as the owner of the
# repo checkout and the sanctioned Cloudflare token (not a DynamicUser like
# the secrets-less liveness probe).
User=nish
Group=nish
# systemd does not source the nish login shell, so node/npm (under the nish
# toolchain) are not on the default service PATH; the provision script renders
# this placeholder with the node bin dir it resolves (issue #1660).
Environment=PATH=__NODE_BIN_DIR__:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/0509-proof-metric-guard/0509-proof-metric-guard-run.sh
# Three D1-legacy canary runs on a 7-day window must fit comfortably inside a
# single slot; the wall-clock timer cadence is 6 hours.
TimeoutStartSec=600
# A failed verdict must leave the unit failed for watchers; do not restart
# into a tight failure loop.
Restart=no

[Install]
WantedBy=multi-user.target
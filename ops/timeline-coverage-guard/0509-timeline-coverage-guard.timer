[Unit]
Description=Run the 0509 Offer Timeline coverage guard daily
Documentation=https://github.com/Nishfleet/0509/blob/main/docs/ops-backup-uptime.md

[Timer]
# Daily at 09:47 UTC — well after the 04:00 UTC daily digest cron that runs
# the sitemap-timeline cohort backfill and the /ads publisher, so a capture
# night is always counted before the guard verdict, and after the sibling
# demo-brand guard's 09:37 slot (:47 offset follows the guard convention of
# avoiding whole-minute and sibling collisions). The sitemap response is
# cached for one hour, so the verdict reads a render at most ~6h old — every
# domain the nightly backfill published is visible.
OnCalendar=*-*-* 09:47:00
Persistent=true
Unit=0509-timeline-coverage-guard.service

[Install]
WantedBy=timers.target

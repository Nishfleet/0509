[Unit]
Description=0509 advertised-URL coverage guard (issue #3166)
Documentation=https://github.com/Nishfleet/0509/blob/main/docs/ops-backup-uptime.md
# Independent of any GitHub Actions runner: the guard must keep firing while
# every runner is busy or offline, and its failure must reach journald + a
# watchdog even when GitHub's scheduled-cron lottery would skip it. This is
# the guard class that catches "the deploy chain is red and production is
# stale while every source-side test is green".

[Service]
Type=oneshot
# Runs as nish: the guard reads the nish-owned repo checkout and needs the
# ambient gh auth for the canary's --file-issue divergence path (same shape
# as the timeline-coverage guard; NO Cloudflare token is needed — the canary
# is a public-surface probe).
User=nish
Group=nish
# Optional operator-provided env (root-owned 0600), e.g.
#   CANARY_BYPASS_TOKEN=<token>
# which switches the run from crawl-parity slow pacing (~17 min) to the
# canary's fast default pacing. The file is OPTIONAL — the "-" prefix means
# the unit starts fine without it and simply paces slowly.
EnvironmentFile=-/etc/0509-sitemap-coverage-guard/env
ExecStart=/opt/0509-sitemap-coverage-guard/0509-sitemap-coverage-guard-run.sh
# Full token-less pass: ~180 URLs at 1 req / 5.2s plus retries ≈ 17-20 min.
TimeoutStartSec=1800
# A failed verdict must leave the unit failed for watchers; do not restart
# into a tight failure loop.
Restart=no

[Install]
WantedBy=multi-user.target
